# Public image folder — including admin-uploaded content under each
# bucket subfolder. Uploads are already validated by real content-sniffing
# (see admin/inc/uploads.php), but this is defense in depth: even if a
# non-image file ever ended up here, the server must never execute it.
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|asp|aspx|sh|exe|dll)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -ExecCGI
