# =====================================================================
# Green Divine — Clean SEO URL Rewriting
# Routes every request (that isn't a real file/dir) to index.php?route=...
# =====================================================================

RewriteEngine On

# ---------------------------------------------------------------------
# Folder-agnostic: NO hardcoded RewriteBase.
# All rewrite targets below are RELATIVE (no leading slash), so Apache
# resolves them against whatever directory this .htaccess lives in —
# /greendivine-1/, /greendivine/, the document root on production, etc.
# This file therefore needs no editing when the folder is renamed or
# moved. (The PHP side, GD_BASE in data.php, auto-detects the same way.)
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# Legacy pages kept from the old static site live in real folders:
#   /artificial-vertical-garden/            -> artificial-vertical-garden/index.html
#   /Products/Artificial Vertical Garden/   -> Products/Artificial Vertical Garden/index.html
# (their assets are in assets2/). Those folders would otherwise hijack
# these current-site URLs, so route them to index.php BEFORE the
# real-file/dir skip below. Patterns are case-sensitive on purpose.
#
# mod_dir's automatic "add a slash to folders" redirect fires before these
# rewrites can take effect, so it is switched off and re-done by hand
# (after the guards) for every other real folder.
# ---------------------------------------------------------------------
DirectorySlash Off

# /artificial-vertical-garden (no slash) stays the current category page
RewriteRule ^artificial-vertical-garden$  index.php?route=artificial-vertical-garden  [QSA,L]

# /products and /products/<category> (the Products/ folder matches them on
# case-insensitive filesystems such as Windows/XAMPP, where Apache also
# reports the folder's on-disk case — hence [NC]). The legacy
# "Products/Artificial Vertical Garden/" never matches: it has spaces.
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^products/$                   %1                                  [NC,R=301,L]
RewriteRule ^products$                    index.php?route=products            [NC,QSA,L]
RewriteRule ^products/([a-z0-9_\-]+)/?$   index.php?route=products&filter=$1  [NC,QSA,L]

# Any other real folder requested without a trailing slash -> add it
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^ %{REQUEST_URI}/ [R=301,L]

# ---------------------------------------------------------------------
# Force trailing-slash removal (e.g. /products/ -> /products).
# Redirect to the full request path minus the trailing slash so it stays
# inside the current folder regardless of where it is mounted.
# ---------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^ %1 [R=301,L]

# ---------------------------------------------------------------------
# Skip real files and directories (assets, images, etc.)
# ---------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ---------------------------------------------------------------------
# Friendly routes -> index.php?route=<slug>
# ---------------------------------------------------------------------

# Home
RewriteRule ^$  index.php?route=home  [QSA,L]

# Single product:  /product/<slug>
RewriteRule ^product/([a-z0-9_\-]+)/?$  index.php?route=product-single&slug=$1  [QSA,L]

# Category landing page:  /category/<slug>
RewriteRule ^category/([a-z0-9_\-]+)/?$ index.php?route=category&slug=$1  [QSA,L]

# Single blog:  /blog/<slug>
RewriteRule ^blog/([a-z0-9_\-]+)/?$  index.php?route=blog-single&slug=$1  [QSA,L]

# Products listing with optional category filter:  /products  or  /products/<category>
RewriteRule ^products/?$                            index.php?route=products              [QSA,L]
RewriteRule ^products/([a-z0-9_\-]+)/?$              index.php?route=products&filter=$1    [QSA,L]

# SEO sitemap + robots.txt — real PHP files so both stay live/current
# (correct absolute domain) rather than static exports.
RewriteRule ^sitemap\.xml$  sitemap.php  [L]
RewriteRule ^robots\.txt$   robots.php   [L]

# Other static pages
RewriteRule ^about/?$       index.php?route=about       [QSA,L]
RewriteRule ^services/?$    index.php?route=services    [QSA,L]
RewriteRule ^blogs/?$       index.php?route=blogs       [QSA,L]
RewriteRule ^contact/?$     index.php?route=contact     [QSA,L]
RewriteRule ^privacy-policy/?$  index.php?route=privacy  [QSA,L]
RewriteRule ^terms/?$           index.php?route=terms    [QSA,L]

# Fallback: anything else -> 404 handler inside index.php
RewriteRule ^(.+)$ index.php?route=$1  [QSA,L]

# =====================================================================
# Performance & security headers
# =====================================================================
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css   "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Block access to sensitive files
<FilesMatch "^(\.htaccess|project_architecture\.md|requirement\.txt)$">
    Require all denied
</FilesMatch>

# NOTE: No ErrorDocument needed — the catch-all RewriteRule above sends every
# unknown path to index.php, which renders the styled 404 page. Adding an
# absolute ErrorDocument path would re-introduce a hardcoded, folder-specific
# route, so it is intentionally omitted to keep this file portable.
