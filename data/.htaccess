# Defense in depth: these .php files only ever `return` an array (no public
# output), so this is redundant today — but it stops them being served as
# plaintext if the PHP handler is ever misconfigured for this folder, and
# blocks direct access outright as a second layer either way.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
